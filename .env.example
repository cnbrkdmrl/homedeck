# Bu dosyayi ".env" olarak kopyala ve doldur. (.env asla git'e eklenmez)

# Sunucunun kendi agent token'i (rastgele; uretmek icin: openssl rand -hex 16)
SERVER_TOKEN=change-me

# Ekrani gosterecek cihazin (tablet/telefon) SABIT IP'si: router'dan DHCP rezervasyonu ya da cihazda statik IP.
# Hub arayuzu/API'si yalnizca bu adrese (ve localhost'a) veri verir.
VIEWER_IP=192.0.2.10

# Ekran duzenleme PIN'i (widget'a uzun basinca sorulur). Bos birakirsan duzenleme kapali.
EDIT_PIN=

# Diger makineler (opsiyonel): ",makine-id:token" biciminde art arda. Her makine icin ayri token.
# EXTRA_AGENT_TOKENS=,laptop:change-me,desktop:change-me

# Baska cihazin da arayuze erismesi gerekirse (ornek bilgisayardan duzenleme). Basinda virgul olmali.
# VIEWER_EXTRA=,192.0.2.20/32

# Konum (hava/gun dogumu): varsayilan Istanbul
# WEATHER_CITY=Istanbul
# WEATHER_LAT=41.01
# WEATHER_LON=28.97

# Home Assistant (opsiyonel): takvim + hava temizleyici/supurge/termostat. Profilden uzun omurlu erisim jetonu olustur.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# Gitea paneli (opsiyonel, salt okuma): uc degiskenin hepsi gerekir. Token yalnizca read:repository yetkili olsun.
# DIKKAT: Gitea token'lari depo bazli degil kullanici geneldir; mumkunse ayri bir salt-okuma kullanicisi ac.
# GITEA_URL=http://gitea.local:3000
# GITEA_REPOS=owner/repo,owner/other-repo
# GITEA_TOKEN=

# Servis kontrolu (opsiyonel): ayakta mi + yanit suresi. ad=adres, virgulle (en cok 8). http(s):// ya da tcp://host:port
# SERVICES=Gitea=http://127.0.0.1:3000,SSH=tcp://127.0.0.1:22

# Gece kisma (opsiyonel): varsayilan 23:00-07:00, parlaklik 0.35. DIM=off kapatir.
# DIM=23:00-07:00
# DIM_LEVEL=0.35

# Modem sayaci (opsiyonel): UPnP/IGD destekleyen modemin gatedesc.xml adresinin kok adresi
# MODEM_UPNP=http://MODEM_IP:PORT

# Webhook icin ek token (opsiyonel)
# PUSH_TOKEN=
